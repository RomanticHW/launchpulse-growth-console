<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LaunchPulse 增长控制台" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LaunchPulse 增长控制台">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <style>
      @font-face { font-family: "Space Grotesk"; src: local("Space Grotesk"); font-display: swap; }
      @font-face { font-family: "IBM Plex Mono"; src: local("IBM Plex Mono"); font-display: swap; }
      @font-face { font-family: "Inter"; src: local("Inter"); font-display: swap; }
    </style>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#eef1f5] antialiased">
    <% if current_user %>
      <div class="lg:hidden" data-controller="drawer" data-action="keydown.esc@window->drawer#close">
        <header class="sticky top-0 z-30 border-b border-paper-line bg-white/95 px-4 py-3 backdrop-blur">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="font-display text-base font-semibold tracking-tight text-console-950">LaunchPulse</div>
              <div class="truncate text-xs text-slate-500">增长控制台</div>
            </div>
            <button
              type="button"
              class="rounded-[var(--radius-control)] border border-paper-line bg-white px-3 py-2 text-sm font-semibold text-console-950 transition hover:bg-paper"
              data-drawer-target="trigger"
              data-action="drawer#open"
              aria-controls="mobile_navigation_drawer"
              aria-expanded="false"
            >导航</button>
          </div>
        </header>

        <div
          class="fixed inset-0 z-40 bg-console-950/35 opacity-0 backdrop-blur-sm transition-opacity duration-150"
          data-drawer-target="backdrop"
          data-action="drawer#close"
          hidden
        ></div>

        <aside
          id="mobile_navigation_drawer"
          class="fixed inset-y-0 left-0 z-50 flex w-[min(360px,calc(100vw-2rem))] -translate-x-full flex-col border-r border-console-line bg-console-950 text-slate-100 opacity-0 shadow-2xl transition duration-200 ease-[var(--ease-signature)]"
          data-drawer-target="panel"
          data-action="keydown->drawer#trapFocus"
          role="dialog"
          aria-modal="true"
          aria-label="移动导航"
          tabindex="-1"
          hidden
        >
          <div class="border-b border-console-line px-5 py-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="font-display text-xl font-semibold tracking-tight text-white">LaunchPulse</div>
                <div class="mt-1 text-xs text-slate-400">增长控制台</div>
              </div>
              <button type="button" class="rounded-[var(--radius-control)] border border-console-line px-2.5 py-1.5 text-xs font-semibold text-slate-300 hover:bg-console-900" data-action="drawer#close">关闭</button>
            </div>
          </div>

          <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
            <% dashboard_active = current_page?(root_path) %>
            <%= link_to root_path, class: "group relative block rounded-[var(--radius-control)] px-3 py-2 text-sm font-medium transition #{dashboard_active ? "bg-console-900 text-signal-amber-tint" : "text-slate-300 hover:bg-console-900 hover:text-white"}" do %>
              <span class="absolute left-0 top-1/2 h-0 w-[3px] -translate-y-1/2 rounded-full bg-signal-amber transition-all duration-150 group-hover:h-6 <%= "h-6" if dashboard_active %>"></span>
              <span class="pl-3">总览</span>
            <% end %>
            <% current_account&.sites&.order(:name)&.each do |site| %>
              <% score_color = if site.growth_score.to_i >= 80
                "bg-signal-amber"
              elsif site.growth_score.to_i >= 60
                "bg-signal-violet"
              else
                "bg-slate-500"
              end %>
              <% active = current_page?(site_path(site)) %>
              <%= link_to site_path(site), class: "group relative flex items-center gap-3 rounded-[var(--radius-control)] px-3 py-2 text-sm transition #{active ? "bg-console-900 text-signal-amber-tint" : "text-slate-300 hover:bg-console-900 hover:text-white"}" do %>
                <span class="absolute left-0 top-1/2 h-0 w-[3px] -translate-y-1/2 rounded-full bg-signal-amber transition-all duration-150 group-hover:h-6 <%= "h-6" if active %>"></span>
                <span class="ml-3 h-1.5 w-1.5 rounded-full <%= score_color %>"></span>
                <span class="truncate"><%= site.name %></span>
              <% end %>
            <% end %>
          </nav>

          <div class="border-t border-console-line p-4">
            <div class="text-sm font-medium text-white"><%= current_user.name %></div>
            <div class="text-xs text-slate-400"><%= current_user.email %></div>
            <%= button_to "退出登录", session_path, method: :delete, class: "mt-3 w-full rounded-[var(--radius-control)] border border-console-line px-3 py-2 text-sm text-slate-300 transition hover:border-slate-500 hover:bg-console-900 hover:text-white" %>
          </div>
        </aside>
      </div>

      <%= render "shared/sidebar" %>
      <main class="min-h-[100dvh] px-4 py-5 lg:ml-64 lg:px-6">
        <%= yield %>
      </main>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
