<section class="bg-[var(--site-base)] px-6 py-14 text-[var(--site-ink)] sm:px-8">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-site-display text-3xl font-semibold tracking-tight"><%= props["headline"] || "精选产品" %></h2>
    <div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(min(100%,13rem),1fr))] gap-4">
    <% current_site = local_assigns[:public_site] || @site %>
    <% Array(props["products"]).each do |product| %>
      <div class="rounded-[var(--radius-panel)] border p-4 transition duration-150 hover:-translate-y-1" style="border-color: color-mix(in srgb, var(--site-accent) 22%, transparent); background: var(--site-surface);">
        <div class="flex aspect-[4/3] items-center justify-center rounded-[var(--radius-control)] p-4" role="img" aria-label="<%= product["name"] %> 产品图示" style="background: radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--site-accent-2) 34%, transparent), transparent 35%), linear-gradient(135deg, color-mix(in srgb, var(--site-accent) 18%, var(--site-surface)), var(--site-surface));">
          <div class="h-full max-h-32 w-full max-w-32">
            <%= render site_product_icon(current_site), variant: product_icon_variant(product["name"]) %>
          </div>
        </div>
        <div class="mt-3 font-site-display text-lg font-semibold"><%= product["name"] %></div>
        <div class="font-mono text-sm opacity-70"><%= product["price"] %></div>
        <% if local_assigns[:public_site] %>
          <% product_key = product["product_key"].presence || product["key"].presence || product["name"].to_s.parameterize %>
          <%= button_to "购买",
            public_site_product_checkout_path(public_site.slug, product_key:),
            method: :post,
            params: { section_uid: section.uid, request_token: SecureRandom.uuid },
            aria: { label: "购买 #{product["name"]}" },
            class: "mt-4 w-full rounded-[var(--radius-control)] px-3 py-2 text-sm font-semibold transition active:translate-y-px",
            style: "background: var(--site-accent); color: var(--site-on-accent);" %>
        <% end %>
      </div>
    <% end %>
    </div>
  </div>
</section>
