<section class="site-hero-visual px-6 py-14 text-[var(--site-ink)] sm:px-8 lg:py-20">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
    <div class="font-site-body">
      <p class="font-mono text-sm font-medium" style="color: var(--site-accent);"><%= props["eyebrow"] || "持续增长" %></p>
      <h1 class="mt-4 max-w-3xl font-site-display text-4xl font-semibold leading-tight tracking-tight lg:text-6xl"><%= props["headline"] %></h1>
      <p class="mt-4 max-w-2xl text-base leading-7 opacity-80"><%= props["subheadline"] %></p>
      <a href="#contact"
         class="mt-7 inline-flex rounded-[var(--radius-control)] px-5 py-3 text-sm font-semibold transition hover:scale-[1.02] focus-visible:scale-[1.02] active:translate-y-px"
         style="background: var(--site-accent); color: var(--site-on-accent); box-shadow: 0 16px 40px color-mix(in srgb, var(--site-accent) 28%, transparent);"
         <% if local_assigns[:public_site] %>
         data-turbo="false"
         data-controller="public-tracking"
         data-public-tracking-url-value="<%= public_site_events_path(public_site.slug) %>"
         data-public-tracking-event-type-value="cta_click"
         data-public-tracking-section-uid-value="<%= section.uid %>"
         data-action="public-tracking#send"
         <% end %>><%= props["cta"] || "开始了解" %></a>
    </div>
    <div class="relative min-h-72 overflow-hidden rounded-[var(--radius-panel)] border p-5" style="border-color: color-mix(in srgb, var(--site-accent) 28%, transparent); background: color-mix(in srgb, var(--site-surface) 78%, transparent);">
      <div class="site-grain absolute inset-0 opacity-70"></div>
      <% current_site = local_assigns[:public_site] || @site %>
      <div class="relative flex h-full min-h-60 items-center justify-center rounded-[var(--radius-panel)] p-4" style="background: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--site-accent) 28%, transparent), transparent 34%), linear-gradient(135deg, color-mix(in srgb, var(--site-accent-2) 18%, var(--site-surface)), var(--site-surface));">
        <div class="h-full max-h-[22rem] w-full max-w-[30rem]">
          <%= render site_hero_illustration(current_site) %>
        </div>
      </div>
    </div>
  </div>
</section>
