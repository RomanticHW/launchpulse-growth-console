<section class="bg-[var(--site-base)] px-6 py-14 text-[var(--site-ink)] sm:px-8">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-site-display text-3xl font-semibold tracking-tight"><%= props["headline"] || "服务亮点" %></h2>
    <div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(min(100%,13rem),1fr))] gap-4">
    <% current_site = local_assigns[:public_site] || @site %>
    <% Array(props["items"]).each_with_index do |item, index| %>
      <div class="rounded-[var(--radius-panel)] border p-5 transition duration-150 hover:-translate-y-1" style="border-color: color-mix(in srgb, var(--site-accent) 24%, transparent); background: color-mix(in srgb, var(--site-surface) 86%, var(--site-base));">
        <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-[var(--radius-control)]" style="background: color-mix(in srgb, var(--site-accent) 10%, var(--site-surface));">
          <%= render site_feature_icon(current_site, index), index: index %>
        </div>
        <div class="font-site-display text-lg font-semibold"><%= item["title"] || item %></div>
        <p class="mt-2 text-sm leading-6 opacity-[0.72]"><%= item["body"] %></p>
      </div>
    <% end %>
    </div>
  </div>
</section>
