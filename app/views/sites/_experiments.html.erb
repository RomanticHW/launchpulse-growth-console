<section id="experiments_panel" class="rounded-[var(--radius-panel)] border border-paper-line bg-white p-4 console-panel-shadow">
  <% experiment_results ||= {} %>
  <div class="flex items-center justify-between gap-3">
    <div>
      <h2 class="font-display text-sm font-semibold text-console-950">实验</h2>
      <div class="mt-1 text-xs text-slate-500">原版本与建议版本的实时对比</div>
    </div>
    <span class="rounded-[var(--radius-pill)] bg-slate-100 px-2.5 py-1 text-xs text-slate-500"><%= experiments.size %> 个实验</span>
  </div>
  <div data-inspector-target="experimentEmpty" class="mt-4 hidden rounded-[var(--radius-control)] bg-paper p-3 text-sm text-slate-500">当前区块暂无实验。</div>

  <div class="mt-4 space-y-3">
    <% experiments.each do |experiment| %>
      <% results = experiment_results.fetch(experiment.id) { Experiments::ResultsService.new(experiment).call } %>
      <% total_weight = results.sum { |result| [ result.fetch(:variant).weight.to_i, 0 ].max } %>
      <% max_rate = [ results.map { |result| result.fetch(:conversion_rate).to_f }.max.to_f, 1 ].max %>
      <% leader = results.reject { |result| result.fetch(:variant).role == "control" || result.fetch(:variant).key == "control" }.max_by { |result| result.fetch(:conversion_rate).to_f } %>
      <% winner_applied = experiment.winner_applied_at.present? %>
      <div class="overflow-hidden rounded-[var(--radius-control)] border <%= winner_applied ? "border-emerald-200 bg-emerald-50/45" : "border-paper-line bg-paper/35" %> p-3" data-inspector-target="experiment" data-section-id="<%= experiment.section_id %>">
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="text-sm font-semibold text-console-950"><%= experiment.name %></div>
            <div class="mt-1 flex flex-wrap gap-1.5 text-[11px] font-medium text-slate-400">
              <span class="rounded-[var(--radius-pill)] bg-white px-2 py-1"><%= event_type_label(experiment.primary_goal) %></span>
              <% if experiment.section %>
                <span class="rounded-[var(--radius-pill)] bg-white px-2 py-1"><%= experiment.section.name %></span>
              <% end %>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-1.5">
            <% if experiment.section %>
              <button type="button" class="rounded-[var(--radius-pill)] border border-paper-line bg-white px-2 py-1 text-[11px] font-semibold text-slate-600 hover:bg-paper" data-action="inspector#selectCard" data-section-id="<%= experiment.section_id %>">定位</button>
            <% end %>
            <% if winner_applied %>
              <span class="rounded-[var(--radius-pill)] bg-emerald-100 px-2 py-1 text-[11px] font-semibold text-emerald-800">胜出版本已应用</span>
            <% else %>
              <span class="rounded-[var(--radius-pill)] bg-signal-violet/10 px-2 py-1 text-[11px] font-semibold text-signal-violet-dim"><%= status_label(experiment.status) %></span>
            <% end %>
          </div>
        </div>
        <div class="mt-3 space-y-2 text-xs">
          <% results.each do |result| %>
            <% variant = result.fetch(:variant) %>
            <% split = total_weight.positive? ? (([ variant.weight.to_i, 0 ].max.to_d / total_weight) * 100).round(1) : 0.to_d %>
            <% is_control = variant.role == "control" || variant.key == "control" %>
            <% width = ((result.fetch(:conversion_rate).to_f / max_rate) * 100).round %>
            <% track_color = is_control ? "bg-signal-amber" : "bg-signal-violet" %>
            <% track_tint = is_control ? "bg-signal-amber/10" : "bg-signal-violet/10" %>
            <% leading_variant = leader && leader.fetch(:variant) == variant && !is_control && result.fetch(:conversion_rate).to_f.positive? %>
            <% winning_variant = experiment.winner_variant_id.present? && experiment.winner_variant_id == variant.id %>
            <div class="rounded-[var(--radius-control)] border bg-white p-3 <%= winning_variant ? "border-emerald-300 ring-2 ring-emerald-400/30" : "border-paper-line" %> <%= "ring-2 ring-emerald-400/40" if leading_variant && !winning_variant %>">
              <div class="flex items-center justify-between gap-2">
                <div class="flex min-w-0 items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full <%= track_color %>"></span>
                  <div class="truncate font-semibold text-console-950"><%= variant.name %></div>
                </div>
                <div class="flex shrink-0 items-center gap-1.5">
                  <% if winning_variant %>
                    <span class="rounded-[var(--radius-pill)] bg-emerald-100 px-2 py-1 text-[10px] font-semibold text-emerald-800">胜出</span>
                  <% elsif leading_variant %>
                    <span class="rounded-[var(--radius-pill)] bg-emerald-50 px-2 py-1 text-[10px] font-semibold text-emerald-700">领先</span>
                  <% end %>
                  <span class="font-mono text-slate-500"><%= split %>% 流量</span>
                </div>
              </div>
              <div class="mt-3 overflow-hidden rounded-[var(--radius-pill)] <%= track_tint %>" data-experiment-progress-bar aria-hidden="true">
                <div class="min-h-8 rounded-[var(--radius-pill)] <%= track_color %> transition-all" style="width: <%= width.clamp(8, 100) %>%"></div>
              </div>
              <div class="mt-3 grid grid-cols-3 gap-2 font-mono text-slate-500">
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-slate-400">访客</div>
                  <div class="text-console-950"><%= result.fetch(:visitors) %></div>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-slate-400">转化</div>
                  <div class="text-console-950"><%= result.fetch(:conversions) %></div>
                </div>
                <div>
                  <div class="text-[10px] uppercase tracking-wide text-slate-400">提升</div>
                  <div class="text-console-950"><%= result.fetch(:lift_label) %></div>
                </div>
              </div>
              <div class="mt-2 flex items-center justify-between gap-2 text-slate-500">
                <span><%= result.fetch(:label) %> · 相对原版 <%= result.fetch(:absolute_delta_vs_control) %> 个百分点</span>
                <span class="font-mono">可信度 <%= result.fetch(:confidence) %>%</span>
              </div>
            </div>
          <% end %>
        </div>
        <div class="mt-3 flex flex-col gap-2">
          <% if experiment.status == "active" %>
            <%= button_to "暂停", pause_site_experiment_path(site, experiment), method: :post, data: { turbo_submits_with: "正在暂停..." }, class: "w-full rounded-[var(--radius-control)] border border-paper-line px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-white" %>
            <%= button_to "完成", complete_site_experiment_path(site, experiment), method: :post, data: { turbo_submits_with: "正在完成..." }, class: "w-full rounded-[var(--radius-control)] border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-100" %>
          <% elsif experiment.status == "paused" %>
            <%= button_to "继续", resume_site_experiment_path(site, experiment), method: :post, data: { turbo_submits_with: "正在继续..." }, class: "w-full rounded-[var(--radius-control)] border border-paper-line px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-white" %>
            <%= button_to "完成", complete_site_experiment_path(site, experiment), method: :post, data: { turbo_submits_with: "正在完成..." }, class: "w-full rounded-[var(--radius-control)] border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-100" %>
          <% elsif experiment.status == "completed" && experiment.winner_applied_at.blank? %>
            <% decision_leader = results.max_by { |result| [ result.fetch(:conversion_rate).to_f, result.fetch(:conversions).to_i ] } %>
            <% results.each do |result| %>
              <% variant = result.fetch(:variant) %>
              <% primary_decision = decision_leader && decision_leader.fetch(:variant) == variant && result.fetch(:conversion_rate).to_f.positive? %>
              <% button_class = primary_decision ? "border-emerald-600 bg-emerald-600 text-white hover:bg-emerald-700" : "border-paper-line bg-white text-slate-600 hover:bg-paper" %>
              <%= button_to "应用 #{variant.name}", apply_winner_site_experiment_path(site, experiment, variant_id: variant.id), method: :post, data: { turbo_submits_with: "正在应用..." }, class: "w-full rounded-[var(--radius-control)] border px-3 py-2 text-sm font-semibold transition #{button_class}" %>
            <% end %>
          <% elsif experiment.winner_applied_at.present? %>
            <div class="rounded-[var(--radius-control)] bg-emerald-100 px-3 py-2 text-center text-sm font-semibold text-emerald-800">胜出版本已应用</div>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if experiments.empty? %>
      <div class="rounded-[var(--radius-control)] bg-paper p-3 text-sm text-slate-500" data-inspector-target="overview">从诊断建议启动实验。</div>
    <% end %>
  </div>
</section>
