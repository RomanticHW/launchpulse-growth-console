#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
OUTPUT="${1:-"$ROOT/../launchpulse-demo.zip"}"

cd "$ROOT"
OUTPUT="$(python3 - "$ROOT" "$OUTPUT" <<'PY'
import os
import sys

root = os.path.realpath(sys.argv[1])
output = os.path.realpath(os.path.abspath(sys.argv[2]))

if os.path.commonpath([root, output]) == root:
    raise SystemExit(f"Output path must be outside project root: {output}")

print(output)
PY
)"
OUTPUT_DIR="$(dirname "$OUTPUT")"

rm -f "$OUTPUT"
TEMP_DIR="$(mktemp -d "$OUTPUT_DIR/.package-demo.XXXXXX")"
TEMP_OUTPUT="$TEMP_DIR/package.zip"
MANIFEST="$TEMP_DIR/tracked-files"

cleanup() {
  rm -rf "$TEMP_DIR"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

git ls-files -z --cached > "$MANIFEST"

python3 - "$ROOT" "$TEMP_OUTPUT" "$MANIFEST" <<'PY'
import datetime
import os
from pathlib import PurePosixPath
import shutil
import stat
import sys
import zipfile


def normalized_path(name):
    if not name or "\\" in name:
        return None
    path = PurePosixPath(name)
    if path.is_absolute() or path.as_posix() != name:
        return None
    if any(part in ("", ".", "..") for part in path.parts):
        return None
    return path


def blocked_path(path):
    parts = path.parts
    lowered = tuple(part.lower() for part in parts)
    basename = lowered[-1]

    if any(part == ".git" for part in parts):
        return True
    if parts[0] in ("__MACOSX", ".kamal", "tmp", "log", "storage", "output",
                    ".playwright-cli", ".bundle", "coverage"):
        return True
    if basename == ".ds_store":
        return True
    if parts[:2] in (("docs", "superpowers"), ("vendor", "bundle"),
                     ("public", "assets")):
        return True
    if parts[:3] == ("app", "assets", "builds"):
        return True
    if any(part == ".env" or part.startswith(".env.") for part in lowered):
        return True
    if len(parts) >= 2 and parts[0] == "config" and parts[1].lower().endswith(".key"):
        return True
    if parts[:2] == ("config", "credentials") and basename.endswith(".key"):
        return True
    return basename.endswith((".pem", ".p12", ".pfx"))


def open_tracked_file(root_descriptor, path):
    nofollow = getattr(os, "O_NOFOLLOW", 0)
    directory = getattr(os, "O_DIRECTORY", 0)
    if not nofollow or not directory:
        raise OSError("Secure descriptor traversal is unavailable")

    directory_descriptor = os.dup(root_descriptor)
    try:
        for component in path.parts[:-1]:
            child_descriptor = os.open(
                component,
                os.O_RDONLY | directory | nofollow,
                dir_fd=directory_descriptor
            )
            os.close(directory_descriptor)
            directory_descriptor = child_descriptor

        file_descriptor = os.open(
            path.parts[-1],
            os.O_RDONLY | nofollow,
            dir_fd=directory_descriptor
        )
        try:
            metadata = os.fstat(file_descriptor)
            if not stat.S_ISREG(metadata.st_mode):
                raise OSError("Tracked entry is not a regular file")
        except BaseException:
            os.close(file_descriptor)
            raise
        return file_descriptor, metadata
    finally:
        os.close(directory_descriptor)


def validate_file(root, root_descriptor, relative, path):
    candidate = os.path.join(root, *path.parts)
    resolved = os.path.realpath(candidate)
    try:
        if os.path.commonpath([root, resolved]) != root:
            return False
    except ValueError:
        return False

    try:
        file_descriptor, _metadata = open_tracked_file(root_descriptor, path)
    except OSError:
        return False
    os.close(file_descriptor)
    return True


root = os.path.realpath(sys.argv[1])
output = sys.argv[2]
manifest_data = open(sys.argv[3], "rb").read()
if manifest_data and not manifest_data.endswith(b"\0"):
    raise SystemExit("Invalid tracked-file manifest")

raw_names = manifest_data.split(b"\0")[:-1] if manifest_data else []
root_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
root_descriptor = os.open(root, root_flags)
files = []
blocked = []
unsafe = []
duplicates = []
seen = set()
for raw_name in raw_names:
    relative = os.fsdecode(raw_name)
    if relative in seen:
        if relative not in duplicates:
            duplicates.append(relative)
        continue
    seen.add(relative)
    path = normalized_path(relative)
    if path is None:
        unsafe.append(relative)
    elif blocked_path(path):
        blocked.append(relative)
    elif not validate_file(root, root_descriptor, relative, path):
        unsafe.append(relative)
    else:
        files.append((relative, path))

if duplicates:
    raise SystemExit("Duplicate tracked paths: " + ", ".join(duplicates))
if blocked:
    raise SystemExit("Blocked package paths: " + ", ".join(blocked))
if unsafe:
    raise SystemExit("Unsafe tracked paths: " + ", ".join(unsafe))

with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED) as archive:
    for relative, path in files:
        if not validate_file(root, root_descriptor, relative, path):
            raise SystemExit("Unsafe tracked paths: " + relative)
        try:
            descriptor, metadata = open_tracked_file(root_descriptor, path)
        except OSError:
            raise SystemExit("Unsafe tracked paths: " + relative) from None
        modified = datetime.datetime.fromtimestamp(metadata.st_mtime)
        modified = max(modified, datetime.datetime(1980, 1, 1))
        info = zipfile.ZipInfo(relative, modified.timetuple()[:6])
        info.compress_type = zipfile.ZIP_DEFLATED
        info.external_attr = (metadata.st_mode & 0xFFFF) << 16
        with os.fdopen(descriptor, "rb") as source, archive.open(info, "w", force_zip64=True) as target:
            shutil.copyfileobj(source, target)
os.close(root_descriptor)
PY

python3 - "$TEMP_OUTPUT" <<'PY'
from pathlib import PurePosixPath
import stat
import sys
import zipfile


def normalized_path(name):
    entry = name[:-1] if name.endswith("/") else name
    if not entry or "\\" in entry:
        return None
    path = PurePosixPath(entry)
    if path.is_absolute() or path.as_posix() != entry:
        return None
    if any(part in ("", ".", "..") for part in path.parts):
        return None
    return path


def blocked_path(path):
    parts = path.parts
    lowered = tuple(part.lower() for part in parts)
    basename = lowered[-1]

    if any(part == ".git" for part in parts):
        return True
    if parts[0] in ("__MACOSX", ".kamal", "tmp", "log", "storage", "output",
                    ".playwright-cli", ".bundle", "coverage"):
        return True
    if basename == ".ds_store":
        return True
    if parts[:2] in (("docs", "superpowers"), ("vendor", "bundle"),
                     ("public", "assets")):
        return True
    if parts[:3] == ("app", "assets", "builds"):
        return True
    if any(part == ".env" or part.startswith(".env.") for part in lowered):
        return True
    if len(parts) >= 2 and parts[0] == "config" and parts[1].lower().endswith(".key"):
        return True
    if parts[:2] == ("config", "credentials") and basename.endswith(".key"):
        return True
    return basename.endswith((".pem", ".p12", ".pfx"))


blocked = []
unsafe = []
non_ascii_readmes = []
duplicates = []
seen = set()
with zipfile.ZipFile(sys.argv[1]) as archive:
    for entry in archive.infolist():
        path = normalized_path(entry.filename)
        if path is None:
            unsafe.append(entry.filename)
            continue
        canonical = path.as_posix()
        if canonical in seen:
            if canonical not in duplicates:
                duplicates.append(canonical)
            continue
        seen.add(canonical)
        if path.parts[0] == "readme" and any(ord(char) > 127 for char in entry.filename):
            non_ascii_readmes.append(entry.filename)
        if blocked_path(path):
            blocked.append(entry.filename)
        mode = entry.external_attr >> 16
        if stat.S_ISLNK(mode):
            unsafe.append(entry.filename)

if duplicates:
    raise SystemExit("Duplicate package entries: " + ", ".join(duplicates))
if non_ascii_readmes:
    raise SystemExit("Non-ASCII readme filenames in package: " + ", ".join(non_ascii_readmes))
if blocked:
    raise SystemExit("Unexpected local artifacts in package: " + ", ".join(blocked))
if unsafe:
    raise SystemExit("Unsafe package entries: " + ", ".join(unsafe))
PY

mv -f "$TEMP_OUTPUT" "$OUTPUT"

echo "Created $OUTPUT"
echo "Package verification passed."
echo "Use this package for sharing. Do not zip the project folder directly from Finder or the OS file browser."
